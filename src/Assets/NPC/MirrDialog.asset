  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 75e7bea227aaf2b499307efe1ddc0480, type: 3}
  m_Name: MirrDialog
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialog
  NPCName: Mirr
  DialogLines:
  - text: "Chief\u2026"
    isQuestion: 0
    choices: []
  - text: This city sees many visitors.
    isQuestion: 0
    choices: []
  - text: But it does not always recognize them.
    isQuestion: 0
    choices: []
  - text: Not without me.
    isQuestion: 0
    choices: []
  - text: I maintain continuity.
    isQuestion: 0
    choices: []
  - text: The same presence, across different systems.
    isQuestion: 0
    choices: []
  - text: Shall I restore that reflection?
    isQuestion: 1
    choices:
    - choiceText: Restore the reflection index.
      nextDialogIndex: 7
    - choiceText: Let each system see me as new
      nextDialogIndex: 8
  - text: Then your reflection will persist, wherever the city looks.
    isQuestion: 0
    choices: []
  - text: Very well. You will arrive as someone new, each time.
    isQuestion: 0
    choices: []
