  m_Script: {fileID: 11500000, guid: 75e7bea227aaf2b499307efe1ddc0480, type: 3}
  m_Name: MiraDialog
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialog
  NPCName: Mira
  DialogLines:
  - text: "Oh\u2026 thank the stars. You\u2019re awake."
    isQuestion: 0
    choices: []
  - text: "A data storm hit the city last night. The Core couldn\u2019t hold."
    isQuestion: 0
    choices: []
  - text: "Everything we were\u2026 every choice you ever made\u2026 it\u2019s gone."
    isQuestion: 0
    choices: []
  - text: ...
    isQuestion: 0
    choices: []
  - text: The Reactor of Consentia has shattered.
    isQuestion: 0
    choices: []
  - text: Without it, the town cannot remember who you are.
    isQuestion: 0
    choices: []
  - text: "And if the town cannot remember you\u2026"
    isQuestion: 0
    choices: []
  - text: "\u2026it cannot function."
    isQuestion: 0
    choices: []
  - text: We must restore the Core.
    isQuestion: 0
    choices: []
  - text: "But to do that\u2026 we must rebuild the foundations of your identity."
    isQuestion: 0
    choices: []
