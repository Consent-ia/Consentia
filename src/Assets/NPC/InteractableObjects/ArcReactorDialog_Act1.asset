  m_Script: {fileID: 11500000, guid: 75e7bea227aaf2b499307efe1ddc0480, type: 3}
  m_Name: ArcReactorDialog_Act1
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialog
  NPCName: Arc Reactor
  DialogLines:
  - text: ...hummm...
    isQuestion: 0
    choices: []
  - text: Signal detected.
    isQuestion: 0
    choices: []
  - text: You stand before the Arc Reactor of Consentia.
    isQuestion: 0
    choices: []
  - text: "Core integrity\u2026 compromised."
    isQuestion: 0
    choices: []
  - text: The data storm fractured my memory lattice.
    isQuestion: 0
    choices: []
  - text: My connections to the three districts have been severed.
    isQuestion: 0
    choices: []
  - text: "Without them\u2026 the city cannot restore itself."
    isQuestion: 0
    choices: []
  - text: "...processing\u2026"
    isQuestion: 0
    choices: []
  - text: A gateway channel is still operational.
    isQuestion: 0
    choices: []
  - text: I will route you to the nearest disrupted district.
    isQuestion: 0
    choices: []
  - text: "Speak with those who remain there\u2026 and restore what was lost."
    isQuestion: 0
    choices: []
  - text: Consentia depends on it.
    isQuestion: 0
    choices: []
  - text: "Initializing gateway\u2026"
    isQuestion: 0
    choices: []
