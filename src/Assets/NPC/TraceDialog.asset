--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 75e7bea227aaf2b499307efe1ddc0480, type: 3}
  m_Name: TraceDialog
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialog
  NPCName: Trace
  DialogLines:
  - text: Hey, Chief.
    isQuestion: 0
    choices: []
  - text: "You move through the city\u2026 but the city doesn\u2019t always follow."
    isQuestion: 0
    choices: []
  - text: Used to be different.
    isQuestion: 0
    choices: []
  - text: "Step somewhere once\u2026"
    isQuestion: 0
    choices: []
  - text: and later, somewhere else, the system remembers your pattern.
    isQuestion: 0
    choices: []
  - text: I handle those trails.
    isQuestion: 0
    choices: []
  - text: Link them up across districts.
    isQuestion: 0
    choices: []
  - text: Want me to reconnect it?
    isQuestion: 1
    choices:
    - choiceText: Reconnect the signal trail
      nextDialogIndex: 8
    - choiceText: Leave no linked trail
      nextDialogIndex: 9
  - text: "Nice. Your trail\u2019s back online. Easier for the network to keep up
      with you."
    isQuestion: 0
    choices: []
  - text: Clean moves. Nothing sticks, nothing follows.
    isQuestion: 0
    choices: []
