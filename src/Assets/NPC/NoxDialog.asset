  m_Script: {fileID: 11500000, guid: 75e7bea227aaf2b499307efe1ddc0480, type: 3}
  m_Name: NoxDialog
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialog
  NPCName: Nox
  DialogLines:
  - text: "Hold still chief\u2026 the lighting in this district. It's a mess!"
    isQuestion: 0
    choices: []
  - text: After the data storm, the lamps forgot how bright they should be.
    isQuestion: 0
    choices: []
  - text: Some of us prefer the quiet glow of night.
    isQuestion: 0
    choices: []
  - text: Others want clear daylight panels so every detail stands out.
    isQuestion: 0
    choices: []
  - text: "I can tune the city\u2019s lights to suit you."
    isQuestion: 0
    choices: []
  - text: "If you\u2019d like\u2026 I can also remember your preference."
    isQuestion: 1
    choices:
    - choiceText: Set the lighting and remember it.
      nextDialogIndex: 6
    - choiceText: Set it just for now.
      nextDialogIndex: 7
  - text: Excellent. The district will adjust itself whenever you return.
    isQuestion: 0
    choices: []
  - text: "No problem. I\u2019ll reset the lamps when you leave."
    isQuestion: 0
    choices: []
