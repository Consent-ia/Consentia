  m_Script: {fileID: 11500000, guid: 75e7bea227aaf2b499307efe1ddc0480, type: 3}
  m_Name: MiraDialog_Act5
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialog
  NPCName: Mira
  DialogLines:
  - text: "Chief\u2026 you're back!"
    isQuestion: 0
    choices: []
  - text: "I knew you could do it. I just\u2026 I didn't know how long it would take."
    isQuestion: 0
    choices: []
  - text: When the storm hit, I wasn't sure the town would recover. But here we are.
    isQuestion: 0
    choices: []
  - text: "The Hearth District, the Undercroft, the Scarlet Exchange\u2026 all of
      it, restored."
    isQuestion: 0
    choices: []
  - text: And it was your decisions that brought it back. Every single one of them.
    isQuestion: 0
    choices: []
  - text: Thank you, Chief. Truly.
    isQuestion: 0
    choices: []
  - text: Now go... the Core is waiting for you. I think it has something to show
      you!
    isQuestion: 0
    choices: []
