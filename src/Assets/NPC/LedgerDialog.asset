  NPCName: Ledger
  DialogLines:
  - text: Chief. Imma be real with you.
    isQuestion: 0
    choices: []
  - text: Signals are active.
    isQuestion: 0
    choices: []
  - text: Results are not.
    isQuestion: 0
    choices: []
  - text: "We don\u2019t know what works."
    isQuestion: 0
    choices: []
  - text: Enable response tracking?
    isQuestion: 1
    choices:
    - choiceText: Enable response logging.
      nextDialogIndex: 5
    - choiceText: Leave it unmeasured.
      nextDialogIndex: 6
  - text: Confirmed. Signal-to-action tracking restored.
    isQuestion: 0
    choices: []
  - text: Understood. Operations continue without measurement.
    isQuestion: 0
    choices: []
