--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 75e7bea227aaf2b499307efe1ddc0480, type: 3}
  m_Name: LexiDialog
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialog
  NPCName: Lexi
  DialogLines:
  - text: 'Ah...Chief! You''re here. '
    isQuestion: 0
    choices: []
  - text: Your speech... it seems to be rendering in default glyph format.
    isQuestion: 0
    choices: []
  - text: I specialize in translation matrices.
    isQuestion: 0
    choices: []
  - text: I can display your words the way you prefer.
    isQuestion: 0
    choices: []
  - text: If you like, I can keep a small translation note for you.
    isQuestion: 0
    choices: []
  - text: That way, next time you arrive, everything will already be written the
      way you understand.
    isQuestion: 1
    choices:
    - choiceText: Keep the translation note.
      nextDialogIndex: 6
    - choiceText: Ask me again next time.
      nextDialogIndex: 7
  - text: Understood. I will remember your preferred glyphs.
    isQuestion: 0
    choices: []
  - text: Very well. I will ask again when we meet.
    isQuestion: 0
    choices: []
